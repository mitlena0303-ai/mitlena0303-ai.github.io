---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import { SITE } from '../../site';
import { readingTime } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('news', ({ data }) => !data.draft);
  return items.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(note.body ?? '');
const pub = note.data.pubDate;
const upd = note.data.updatedDate ?? pub;
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

// Обложка новости — своя (генерируется отдельно), не превью YouTube.
const cover = note.data.cover;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: note.data.title,
  description: note.data.description,
  datePublished: pub.toISOString(),
  dateModified: upd.toISOString(),
  inLanguage: 'ru',
  ...(cover ? { image: new URL(cover, Astro.site).toString() } : {}),
  author: { '@type': 'Person', name: SITE.author, description: SITE.authorBio },
  publisher: { '@type': 'Organization', name: SITE.name },
};

const faqLd = note.data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: note.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Новости', item: new URL('/news', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: note.data.title },
  ],
};

const jsonLd = faqLd ? [articleLd, faqLd, breadcrumbLd] : [articleLd, breadcrumbLd];
---
<Base title={note.data.title} description={note.data.description} jsonLd={jsonLd} ogImage={cover}>
  <div class="note-layout">
    <article class="note-main">
      <header class="art-head">
        <p class="meta">
          <a href="/news">Новости</a> · {fmt(pub)} · {minutes} мин чтения
        </p>
        <h1>{note.data.title}</h1>
        <p class="lede">{note.data.description}</p>
        <div class="tags">{note.data.topics.map((t) => <span class="tag">#{t}</span>)}</div>
      </header>

      {cover && (
        <img class="cover-img" src={cover} alt={note.data.title} width="1280" height="720" loading="eager" />
      )}

      <div class="prose">
        <Content />
      </div>

      {note.data.faq?.length && (
        <section class="faq" aria-label="Частые вопросы">
          <h2>Частые вопросы</h2>
          {note.data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {note.data.videoUrl && (
        <p class="src-footer">
          Разбор по мотивам <a href={note.data.videoUrl} target="_blank" rel="noopener">видео на канале «{note.data.channel}»</a>.
          Текст передаёт суть своими словами, все права на оригинал у автора. Оригинал можно <a href={note.data.videoUrl} target="_blank" rel="noopener">посмотреть на YouTube</a>.
        </p>
      )}

      <LeadMagnet />
    </article>

    <aside class="note-side">
      <div class="side-card">
        <h3>Автор</h3>
        <p class="au-name">{SITE.author}</p>
        <p class="au-bio">{SITE.authorBioNews}</p>
        <a class="tg-btn" href={SITE.telegram} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.94 4.53 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.18c-.25.25-.46.46-.94.46l.33-4.78 8.7-7.86c.38-.34-.08-.53-.59-.19L6.98 13.2l-4.64-1.45c-1-.32-1.02-1 .21-1.48l18.15-7c.84-.3 1.57.2 1.24 1.76z"/></svg>
          Подписаться в Telegram
        </a>
      </div>

      {note.data.videoUrl && (
        <div class="side-card">
          <h3>Источник</h3>
          {note.data.channel && <p class="src-row"><span>Канал</span><b>{note.data.channel}</b></p>}
          <p class="src-row"><span>Обновлено</span><b>{fmt(upd)}</b></p>
          <p class="src-link"><a href={note.data.videoUrl} target="_blank" rel="noopener">Смотреть оригинал на YouTube →</a></p>
        </div>
      )}

      {toc.length > 1 && (
        <nav class="side-card toc-card" aria-label="Содержание">
          <h3>Содержание</h3>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="side-slot" data-slot="banner"></div>
    </aside>
  </div>
</Base>

<style>
  .note-layout {
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
    align-items: start;
  }
  .note-main { min-width: 0; }
  .note-main .prose,
  .note-main .lede,
  .note-main .faq,
  .note-main .src-footer { max-width: 780px; }

  .art-head { padding: 48px 0 8px; }
  .art-head h1 { font-size: clamp(30px, 4.4vw, 46px); margin: 12px 0 16px; max-width: 820px; }
  .art-head .meta a { color: var(--noise); }
  .lede { font-family: var(--font-serif); font-size: 20px; line-height: 1.55; color: #444; margin: 0 0 18px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .tag { font-size: 13px; font-weight: 600; color: var(--noise); }
  .cover-img { width: 100%; max-width: 820px; aspect-ratio: 16 / 9; object-fit: cover; height: auto; border-radius: var(--radius); margin: 14px 0 24px; background: var(--bg-soft); }

  /* Инлайн-графики и скрины из видео */
  .note-main .prose :global(figure) { margin: 26px 0; max-width: 780px; }
  .note-main .prose :global(figure img),
  .note-main .prose :global(p > img) {
    width: 100%; height: auto; display: block;
    border-radius: 14px; border: 1px solid #ececec; background: #f5f5f5;
  }
  .note-main .prose :global(figcaption) {
    font-size: 13.5px; line-height: 1.45; color: var(--noise);
    margin-top: 8px; text-align: center;
  }

  .note-main .prose :global(h2) {
    border-left: 3px solid var(--link);
    padding-left: 16px;
    margin-top: 1.8em;
  }

  .faq { margin-top: 48px; }
  .faq h2 { font-size: 26px; margin-bottom: 16px; border-left: none; padding-left: 0; }
  .faq details { background: var(--bg-soft); border-radius: 12px; padding: 14px 18px; margin: 10px 0; }
  .faq summary { font-weight: 600; color: var(--ink); cursor: pointer; font-size: 16px; }
  .faq details p { margin: 10px 0 2px; font-size: 15.5px; line-height: 1.55; }
  .src-footer { margin-top: 40px; font-size: 14px; color: var(--noise); }
  .src-footer a { color: var(--link); }

  /* Sidebar */
  .note-side {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 48px;
  }
  .side-card { background: var(--bg-soft); border-radius: var(--radius); padding: 20px 22px; }
  .side-card h3 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--noise);
  }
  .au-name { margin: 0 0 6px; font-weight: 700; color: var(--ink); }
  .au-bio { margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #555; }

  /* Голубая TG-кнопка с самолётиком */
  .tg-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; box-sizing: border-box;
    background: #29a9eb; color: #fff;
    font-family: var(--font-ui); font-size: 15px; font-weight: 600;
    text-decoration: none; padding: 11px 16px; border-radius: 12px;
    transition: background 0.15s ease;
  }
  .tg-btn:hover { background: #1e93d1; }
  .tg-btn svg { flex: 0 0 auto; }

  .src-row { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 8px; font-size: 14px; color: var(--noise); }
  .src-row b { color: var(--ink); font-weight: 600; text-align: right; }
  .src-link { margin: 10px 0 0; font-size: 14px; }
  .src-link a { color: var(--link); font-weight: 600; text-decoration: none; }
  .src-link a:hover { text-decoration: underline; }

  .toc-card ol { margin: 0; padding: 0; list-style: none; counter-reset: toc; }
  .toc-card li { margin: 0 0 8px; }
  .toc-card a { color: var(--ink); text-decoration: none; font-size: 14px; line-height: 1.4; counter-increment: toc; }
  .toc-card a::before { content: counter(toc) ". "; color: var(--noise); }
  .toc-card a:hover { color: var(--link); }

  @media (max-width: 900px) {
    .note-layout { grid-template-columns: 1fr; gap: 0; }
    .note-side { position: static; padding-top: 8px; }
    .note-main .prose, .note-main .lede, .note-main .faq, .note-main .src-footer { max-width: 100%; }
  }
</style>
