---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { SITE, FUNNEL, funnelUrl } from '../site';
import { readingTime } from '../utils';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.toString(),
};
---
<Base title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} jsonLd={jsonLd}>
  <section class="flow-head">
    <div class="wrap">
      <h1>{SITE.hero.title}</h1>
      <p class="sub">{SITE.hero.subtitle}</p>
      <a class="btn" href={funnelUrl(FUNNEL.leadMagnet.url, FUNNEL.leadMagnet.campaign, 'cta_hero', Astro.url.pathname)}>{FUNNEL.leadMagnet.label}</a>
    </div>
  </section>

  <section class="wrap">
    <div class="grid">
      {guides.map((g) => (
        <GuideCard
          slug={g.id}
          title={g.data.title}
          description={g.data.description}
          category={g.data.category}
          minutes={readingTime(g.body ?? '')}
          date={g.data.updatedDate ?? g.data.pubDate}
          coverWord={g.data.coverWord}
          coverColor={g.data.coverColor}
          coverImage={g.data.cover}
        />
      ))}
    </div>
  </section>

  <div class="wrap"><LeadMagnet /></div>
</Base>

<style>
  .flow-head { padding: 56px 0 44px; }
  .flow-head h1 {
    font-size: clamp(34px, 5.5vw, 58px);
    margin: 0 0 16px;
  }
  .sub {
    font-size: 18px;
    color: #555;
    max-width: 56ch;
    margin: 0 0 22px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 36px 28px;
  }
</style>
