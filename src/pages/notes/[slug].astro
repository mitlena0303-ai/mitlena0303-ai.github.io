---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import { SITE } from '../../site';
import { readingTime } from '../../utils';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(note.body ?? '');
const pub = note.data.pubDate;
const upd = note.data.updatedDate ?? pub;
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

// Обложка конспекта = превью видео с YouTube (всегда). Фолбэк на локальный cover, если id не распознан.
const ytId = (u = '') => (u.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/) || [])[1] || null;
const vid = ytId(note.data.videoUrl);
const cover = vid ? `https://img.youtube.com/vi/${vid}/maxresdefault.jpg` : note.data.cover;
const coverFallback = vid ? `https://img.youtube.com/vi/${vid}/hqdefault.jpg` : null;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description: note.data.description,
  datePublished: pub.toISOString(),
  dateModified: upd.toISOString(),
  inLanguage: 'ru',
  ...(cover ? { image: new URL(cover, Astro.site).toString() } : {}),
  author: { '@type': 'Person', name: SITE.author, description: SITE.authorBio },
  publisher: { '@type': 'Organization', name: SITE.name },
};

const faqLd = note.data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: note.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Конспекты', item: new URL('/notes', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: note.data.title },
  ],
};

const jsonLd = faqLd ? [articleLd, faqLd, breadcrumbLd] : [articleLd, breadcrumbLd];
---
<Base title={note.data.title} description={note.data.description} jsonLd={jsonLd} ogImage={cover}>
  <div class="note-layout">
    <article class="note-main">
      <header class="art-head">
        <p class="meta">
          <a href="/notes">Конспекты</a> · {minutes} мин чтения · {note.data.level}
        </p>
        <h1>{note.data.title}</h1>
        <p class="lede">{note.data.description}</p>
        <div class="tags">{note.data.topics.map((t) => <span class="tag">#{t}</span>)}</div>
      </header>

      {cover && (
        <img class="cover-img" src={cover} data-fallback={coverFallback} alt={note.data.title} width="1280" height="720" loading="eager"
             onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.removeAttribute('data-fallback');}" />
      )}

      {(note.data.about || note.data.forWhom || note.data.result) && (
        <section class="smart-intro" aria-label="О конспекте">
          <p class="smart-label">📝 Смарт-конспект</p>
          {note.data.about && (
            <p class="si-row"><span class="si-ic">🎯</span><span><b>О чём этот конспект:</b> {note.data.about}</span></p>
          )}
          {note.data.forWhom && (
            <p class="si-row"><span class="si-ic">👤</span><span><b>Кому будет полезно:</b> {note.data.forWhom}</span></p>
          )}
          {note.data.result && (
            <p class="si-row"><span class="si-ic">✨</span><span><b>Что получите:</b> {note.data.result}</span></p>
          )}
        </section>
      )}

      <div class="prose">
        <Content />
      </div>

      {note.data.faq?.length && (
        <section class="faq" aria-label="Частые вопросы">
          <h2>Частые вопросы</h2>
          {note.data.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <p class="src-footer">
        Источник: <a href={note.data.videoUrl} target="_blank" rel="noopener">видео на канале «{note.data.channel}»</a>.
        Конспект передаёт суть своими словами, все права на оригинал у автора.
      </p>

      <LeadMagnet />
    </article>

    <aside class="note-side">
      <div class="side-card">
        <h3>Автор конспекта</h3>
        <p class="au-name">{SITE.author}</p>
        {SITE.authorBio && <p class="au-bio">{SITE.authorBio}</p>}
      </div>

      <div class="side-card">
        <h3>Источник</h3>
        <p class="src-row"><span>Канал</span><b>{note.data.channel}</b></p>
        {note.data.duration && <p class="src-row"><span>Длительность</span><b>{note.data.duration}</b></p>}
        <p class="src-row"><span>Обновлено</span><b>{fmt(upd)}</b></p>
        <a class="btn side-btn" href={note.data.videoUrl} target="_blank" rel="noopener">Смотреть на YouTube</a>
      </div>

      {toc.length > 1 && (
        <nav class="side-card toc-card" aria-label="Содержание">
          <h3>Содержание</h3>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      {/* Резерв под баннеры / блоки интерфейса — заполнится позже */}
      <div class="side-slot" data-slot="banner"></div>
    </aside>
  </div>
</Base>

<style>
  /* Двухколоночная раскладка: широкий контент + sticky-сайдбар */
  .note-layout {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 56px;
    align-items: start;
  }
  .note-main { min-width: 0; }
  /* Читаемая ширина контента — шире прежних 680 */
  .note-main .prose,
  .note-main .lede,
  .note-main .faq,
  .note-main .src-footer { max-width: 900px; }

  .art-head { padding: 48px 0 8px; }
  .art-head h1 { font-size: clamp(30px, 4.4vw, 46px); margin: 12px 0 16px; max-width: 820px; }
  .art-head .meta a { color: var(--noise); }
  .lede { font-family: var(--font-serif); font-size: 20px; line-height: 1.55; color: #444; margin: 0 0 18px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .tag { font-size: 13px; font-weight: 600; color: var(--noise); }
  .cover-img { width: 100%; max-width: 820px; aspect-ratio: 16 / 9; object-fit: cover; height: auto; border-radius: var(--radius); margin: 14px 0 24px; background: var(--bg-soft); }

  /* Смарт-конспект: вводные блоки о чём / кому / что получите — отдельными карточками */
  .smart-intro { max-width: 780px; margin: 8px 0 12px; display: grid; gap: 12px; }
  .smart-label {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--noise); margin: 0 0 2px;
  }
  .si-row {
    display: flex; gap: 14px; align-items: flex-start; margin: 0;
    background: var(--bg-soft); border-radius: 14px; padding: 16px 20px;
    border-left: 3px solid var(--link);
    font-size: 16px; line-height: 1.55; color: #333;
  }
  .si-row .si-ic { flex: 0 0 auto; font-size: 20px; line-height: 1.5; }
  .si-row b { color: var(--ink); font-weight: 700; }

  /* Акцентная левая граница у заголовков секций — как в референсе */
  .note-main .prose :global(h2) {
    border-left: 3px solid var(--link);
    padding-left: 16px;
    margin-top: 1.8em;
  }

  /* Инлайн-графики и скрины из видео */
  .note-main .prose :global(figure) { margin: 26px 0; max-width: 780px; }
  .note-main .prose :global(figure img),
  .note-main .prose :global(p > img) {
    width: 100%; height: auto; display: block;
    border-radius: 14px; border: 1px solid #ececec; background: #f5f5f5;
  }
  .note-main .prose :global(figcaption) {
    font-size: 13.5px; line-height: 1.45; color: var(--noise);
    margin-top: 8px; text-align: center;
  }

  .faq { margin-top: 48px; }
  .faq h2 { font-size: 26px; margin-bottom: 16px; border-left: none; padding-left: 0; }
  .faq details { background: var(--bg-soft); border-radius: 12px; padding: 14px 18px; margin: 10px 0; }
  .faq summary { font-weight: 600; color: var(--ink); cursor: pointer; font-size: 16px; }
  .faq details p { margin: 10px 0 2px; font-size: 15.5px; line-height: 1.55; }
  .src-footer { margin-top: 40px; font-size: 14px; color: var(--noise); }

  /* Sidebar */
  .note-side {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 48px;
  }
  .side-card { background: var(--bg-soft); border-radius: var(--radius); padding: 20px 22px; }
  .side-card h3 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--noise);
  }
  .au-name { margin: 0 0 6px; font-weight: 700; color: var(--ink); }
  .au-bio { margin: 0; font-size: 14px; line-height: 1.5; color: #555; }
  .src-row { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 8px; font-size: 14px; color: var(--noise); }
  .src-row b { color: var(--ink); font-weight: 600; text-align: right; }
  .side-btn { display: block; text-align: center; margin-top: 14px; }

  .toc-card ol { margin: 0; padding: 0; list-style: none; counter-reset: toc; }
  .toc-card li { margin: 0; counter-increment: toc; }
  .toc-card a {
    display: block;
    padding: 7px 0;
    font-size: 14px;
    line-height: 1.4;
    color: #555;
    border-left: 2px solid transparent;
    padding-left: 12px;
    margin-left: -12px;
    transition: color .15s, border-color .15s;
  }
  .toc-card a::before { content: counter(toc) ". "; color: var(--noise); }
  .toc-card a:hover { color: var(--ink); }
  .toc-card a.active { color: var(--link); border-left-color: var(--link); font-weight: 600; }

  .side-slot:empty { display: none; }

  /* Мобильная раскладка — одна колонка, сайдбар уходит вниз */
  @media (max-width: 980px) {
    .note-layout { grid-template-columns: 1fr; gap: 24px; }
    .note-side { position: static; padding-top: 8px; }
    .note-main .prose, .note-main .lede, .note-main .faq, .note-main .src-footer { max-width: 100%; }
  }
</style>

<script is:inline>
  // Подсветка активного пункта содержания при скролле
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('.toc-card a[data-toc]'));
    if (!links.length) return;
    var map = {};
    links.forEach(function (a) { map[a.getAttribute('data-toc')] = a; });
    var heads = links.map(function (a) { return document.getElementById(a.getAttribute('data-toc')); }).filter(Boolean);
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          links.forEach(function (l) { l.classList.remove('active'); });
          var a = map[e.target.id];
          if (a) a.classList.add('active');
        }
      });
    }, { rootMargin: '-10% 0px -70% 0px' });
    heads.forEach(function (h) { obs.observe(h); });
  })();
</script>
